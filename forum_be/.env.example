# ==========================================
# 백엔드 환경변수 설정 예시 (.env)
# ==========================================

# 데이터베이스 접속 정보
DB_URL=jdbc:mysql://localhost:3306/forum_db?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=root

# JWT 시크릿 키 (최소 32바이트 이상 문자열) 및 만료시간(ms 단위)
JWT_SECRET=YourSuperSecretKeyForJWTTokenGenerationMustBeAtLeast32Bytes!
JWT_EXPIRATION=3600000

# 서버 포트
SERVER_PORT=8080

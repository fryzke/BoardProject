# ===================================================================
# Forum Backend Environment Variables Example (.env.example)
# ===================================================================

# ===== Database (MySQL) =====
DB_URL=jdbc:mysql://localhost:3306/forum_db?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# ===== Server =====
SERVER_PORT=8080

# ===== JWT Security =====
JWT_SECRET=YourSuperSecretKeyForJWTTokenGenerationMustBeAtLeast32Bytes!
JWT_EXPIRATION=1800000

# ===== Redis Cache =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== File & Image Upload =====
FILE_UPLOAD_DIR=uploads
FILE_ACCESS_URL_PREFIX=http://localhost:8080/uploads
FILE_MAX_SINGLE_SIZE=20971520
FILE_MAX_TOTAL_SIZE=104857600
FILE_MAX_COUNT=10
MULTIPART_MAX_FILE_SIZE=20MB
MULTIPART_MAX_REQUEST_SIZE=20MB
TOMCAT_MAX_POST_SIZE=20MB
TOMCAT_MAX_SWALLOW_SIZE=20MB

# ===== Post Policy Constants =====
POST_MIN_TITLE_LENGTH=2
POST_MAX_TITLE_LENGTH=100
POST_MIN_CONTENT_LENGTH=1
POST_MAX_CONTENT_LENGTH=20000
POST_MAX_PINNED_COUNT=5

# ===== Comment Policy Constants =====
COMMENT_MAX_DEPTH=9

# ===== Auth Policy Constants =====
AUTH_MIN_USER_ID_LENGTH=4
AUTH_MAX_USER_ID_LENGTH=16

# ===== Application Initialization =====
APP_INIT_DATA=true

# ===== Batch Scheduler =====
CLEANUP_SCHEDULE_CRON=0 0 3 * * *
